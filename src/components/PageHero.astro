---
interface Props { eyebrow: string; title: string; description: string; image?: string; imageAlt?: string; }
const { eyebrow, title, description, image = '/images/shinotsu-overview.webp', imageAlt = '' } = Astro.props;
---
<section class="container-shell pt-10 md:pt-16">
  <div class="grid items-end gap-8 lg:grid-cols-[.9fr_1.1fr]">
    <div class="pb-2 lg:pb-10">
      <span class="eyebrow">{eyebrow}</span>
      <h1 class="display-title mt-5 text-4xl md:text-6xl">{title}</h1>
      <p class="lead-text mt-6 max-w-xl">{description}</p>
    </div>
    <div class="photo-frame aspect-[16/10] rounded-[1.5rem] lg:aspect-[5/3]">
      <img src={image} alt={imageAlt} width="1600" height="1067" fetchpriority="high" />
    </div>
  </div>
</section>

---
import Icon from './Icon.astro';
import { site } from '@/data/site';
---
<section class="rounded-2xl border border-[var(--line)] bg-white/55 p-7 shadow-sm" aria-label="Google マップの評価">
  <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex items-center gap-5">
      <p class="font-serif text-5xl leading-none text-[var(--ink)]">{site.rating.toFixed(1)}</p>
      <div>
        <div class="flex items-center gap-1" aria-hidden="true">
          {[0, 1, 2, 3, 4].map((i) => (
            <Icon name="star" class:list={['h-5 w-5', i < Math.round(site.rating) ? 'text-[var(--sun)]' : 'text-[var(--line)]']} />
          ))}
        </div>
        <p class="mt-1.5 text-sm text-[var(--ink-soft)]">Google マップのユーザー評価　{site.reviewCount.toLocaleString('ja-JP')} 件</p>
      </div>
    </div>
    <a href={site.reviewSourceUrl} target="_blank" rel="noopener noreferrer" class="btn-secondary">
      Google マップで全ての口コミを見る <Icon name="arrow" class="h-4 w-4" />
    </a>
  </div>
  <p class="mt-5 border-t border-[var(--line)] pt-4 text-xs leading-6 text-[var(--ink-soft)]">
    評価と口コミ数はGoogle マップ（Google Maps）のユーザー評価を同期しています · {site.reviewSyncMonth} · <a href={site.reviewSourceUrl} target="_blank" rel="noopener noreferrer" class="underline underline-offset-2 hover:text-[var(--lake-deep)]">Google マップで全ての口コミを見る↗</a>
  </p>
</section>

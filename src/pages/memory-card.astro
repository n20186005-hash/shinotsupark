---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Icon from '@/components/Icon.astro';
---
<BaseLayout title="旅の記念カード" description="写真やセルフィーから、しのつ公園の旅の記念カードをブラウザ内のCanvasで作成・保存。画像はアップロードされません。" image="/images/shinotsu-sky.webp" noindex={true}>
  <section class="container-shell pt-12 md:pt-20">
    <div class="max-w-3xl"><span class="eyebrow">MEMORY CARD MAKER</span><h1 class="display-title mt-5 text-4xl md:text-6xl">旅の写真を、<br />しのつの一枚に。</h1><p class="lead-text mt-6">カメラ、セルフィー、アルバムから写真を選び、サイズと風景に合う色を選んでください。合成と保存は、すべてこのブラウザの中で行われます。</p></div>
    <div class="mt-7 inline-flex items-center gap-3 rounded-full border border-[var(--line)] bg-white/60 px-5 py-3 text-xs font-bold text-[var(--lake-deep)]"><Icon name="shield" class="h-4 w-4" />写真はお使いの端末にのみ保存され、サーバーへ送信されません。</div>
  </section>

  <section class="container-shell section-space !pt-12">
    <div class="grid gap-8 lg:grid-cols-[.82fr_1.18fr]">
      <div class="space-y-5 lg:sticky lg:top-24 lg:self-start">
        <section class="rounded-2xl border border-[var(--line)] bg-white/55 p-6">
          <p class="text-xs font-bold tracking-[.15em] text-[var(--lake-deep)]">01 · 写真を選ぶ</p>
          <div class="mt-5 grid gap-3 sm:grid-cols-3 lg:grid-cols-1 xl:grid-cols-3">
            <button type="button" data-file-target="camera-input" class="btn-secondary !rounded-xl !px-3"><Icon name="camera" class="h-4 w-4" />カメラ</button>
            <button type="button" data-file-target="selfie-input" class="btn-secondary !rounded-xl !px-3"><Icon name="camera" class="h-4 w-4" />セルフィー</button>
            <button type="button" data-file-target="gallery-input" class="btn-secondary !rounded-xl !px-3">アルバム</button>
          </div>
          <input id="camera-input" data-photo-input class="sr-only" type="file" accept="image/*" capture="environment" />
          <input id="selfie-input" data-photo-input class="sr-only" type="file" accept="image/*" capture="user" />
          <input id="gallery-input" data-photo-input class="sr-only" type="file" accept="image/*" />
          <p class="mt-4 text-[.68rem] leading-5 text-[var(--ink-soft)]">対応端末ではカメラが開きます。デスクトップではファイル選択として動作します。最大25MB。</p>
        </section>

        <section class="rounded-2xl border border-[var(--line)] bg-white/55 p-6">
          <p class="text-xs font-bold tracking-[.15em] text-[var(--lake-deep)]">02 · サイズ</p>
          <div class="mt-4 grid grid-cols-3 gap-2">
            <label class="cursor-pointer"><input class="peer sr-only" type="radio" name="card-size" value="square" checked /><span class="grid min-h-20 place-items-center rounded-xl border border-[var(--line)] bg-white/40 text-center text-xs font-bold peer-checked:border-[var(--lake-deep)] peer-checked:bg-[rgba(122,165,170,.15)]">1:1<br/><small class="font-normal">正方形</small></span></label>
            <label class="cursor-pointer"><input class="peer sr-only" type="radio" name="card-size" value="postcard" /><span class="grid min-h-20 place-items-center rounded-xl border border-[var(--line)] bg-white/40 text-center text-xs font-bold peer-checked:border-[var(--lake-deep)] peer-checked:bg-[rgba(122,165,170,.15)]">100:148<br/><small class="font-normal">はがき縦</small></span></label>
            <label class="cursor-pointer"><input class="peer sr-only" type="radio" name="card-size" value="story" /><span class="grid min-h-20 place-items-center rounded-xl border border-[var(--line)] bg-white/40 text-center text-xs font-bold peer-checked:border-[var(--lake-deep)] peer-checked:bg-[rgba(122,165,170,.15)]">9:16<br/><small class="font-normal">ストーリー</small></span></label>
          </div>
        </section>

        <section class="rounded-2xl border border-[var(--line)] bg-white/55 p-6">
          <p class="text-xs font-bold tracking-[.15em] text-[var(--lake-deep)]">03 · 色と文字</p>
          <div class="mt-4 grid grid-cols-3 gap-2">
            <label class="cursor-pointer"><input class="peer sr-only" type="radio" name="card-style" value="lake" checked /><span class="block rounded-xl border border-[var(--line)] p-2 text-center text-xs peer-checked:border-[var(--lake-deep)]"><i class="mx-auto mb-2 block h-7 rounded-lg bg-[#4d7e84]"></i>湖畔ブルー</span></label>
            <label class="cursor-pointer"><input class="peer sr-only" type="radio" name="card-style" value="field" /><span class="block rounded-xl border border-[var(--line)] p-2 text-center text-xs peer-checked:border-[var(--lake-deep)]"><i class="mx-auto mb-2 block h-7 rounded-lg bg-[#697b54]"></i>田園グリーン</span></label>
            <label class="cursor-pointer"><input class="peer sr-only" type="radio" name="card-style" value="sunset" /><span class="block rounded-xl border border-[var(--line)] p-2 text-center text-xs peer-checked:border-[var(--lake-deep)]"><i class="mx-auto mb-2 block h-7 rounded-lg bg-[#a56864]"></i>夕空ピンク</span></label>
          </div>
          <label class="mt-5 block text-xs font-bold" for="place-name">スポット名</label><input id="place-name" class="mt-2 w-full rounded-xl border border-[var(--line)] bg-white/70 px-4 py-3 text-sm outline-none focus:border-[var(--lake-deep)]" value="しのつ公園" maxlength="28" />
          <label class="mt-4 block text-xs font-bold" for="visit-date">日付</label><input id="visit-date" class="mt-2 w-full rounded-xl border border-[var(--line)] bg-white/70 px-4 py-3 text-sm outline-none focus:border-[var(--lake-deep)]" placeholder="2026.07.30" maxlength="24" />
        </section>
      </div>

      <div>
        <div class="rounded-[1.6rem] bg-[var(--ink)] p-4 shadow-2xl md:p-7">
          <div class="mx-auto max-w-[620px] overflow-hidden rounded-xl bg-white/10"><canvas id="memory-canvas" class="block h-auto w-full" aria-label="記念カードのプレビュー"></canvas></div>
          <div class="mt-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between"><p id="card-status" class="text-xs text-white/65" aria-live="polite">端末内でプレビューを生成中</p><button id="download-card" type="button" class="btn-primary !border-white !bg-white !text-[var(--ink)]">PNGで保存 <Icon name="download" class="h-4 w-4" /></button></div>
        </div>
        <div class="mt-5 rounded-2xl border border-[var(--line)] bg-white/50 p-6"><h2 class="font-serif text-xl">プライバシーの仕組み</h2><p class="mt-3 text-sm leading-7 text-[var(--ink-soft)]">選んだ写真はJavaScriptでブラウザ内に読み込まれ、Canvasに描画されます。アップロード先、API、データベースはありません。ページを閉じると作業中の写真とカードは破棄されます。保存したPNGだけが、端末のダウンロード先に残ります。</p></div>
      </div>
    </div>
  </section>
  <script>
    import { initMemoryCard } from '@/scripts/memory-card';
    initMemoryCard();
  </script>
</BaseLayout>

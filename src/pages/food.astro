---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import { foods } from '@/data/site';
---
<BaseLayout title="周辺グルメ" description="しのつ公園周辺で味わえる新篠津産の米、野菜、生乳、味噌を使ったレストランとテイクアウト店を紹介。" image="/images/shinotsu-camp-sign.webp">
  <PageHero eyebrow="LOCAL FOOD" title="風景と一緒に、村を味わう。" description="しのつ公園の周りには、新篠津産のお米や野菜、生乳、味噌を使う店があります。公園に隣接する店と、市街の食事処を組み合わせて選べます。" image="/images/shinotsu-camp-sign.webp" imageAlt="しのつ公園キャンプ場の案内と緑" />
  <section class="section-space container-shell">
    <div class="grid gap-6 md:grid-cols-2">
      {foods.map((food, i) => (
        <article class="rounded-[1.5rem] border border-[var(--line)] bg-white/55 p-7 md:p-9">
          <div class="flex items-start justify-between gap-6"><div><p class="text-[.67rem] font-bold tracking-[.15em] text-[var(--lake-deep)]">{food.category} · {food.area}</p><h2 class="mt-3 font-serif text-3xl">{food.name}</h2></div><span class="font-serif text-3xl text-[var(--line)]">0{i+1}</span></div>
          <p class="mt-6 text-base font-semibold leading-8">{food.lead}</p>
          <p class="mt-4 text-sm leading-7 text-[var(--ink-soft)]">{food.detail}</p>
          <div class="mt-7 border-t border-[var(--line)] pt-5"><p class="text-xs font-bold tracking-[.08em]">営業時間の目安</p><p class="mt-2 text-sm text-[var(--ink-soft)]">{food.hours}</p></div>
        </article>
      ))}
    </div>
    <div class="mt-10 rounded-2xl border border-[var(--line)] bg-[var(--paper-deep)] p-6 text-sm leading-7 text-[var(--ink-soft)]"><strong class="text-[var(--ink)]">営業情報について：</strong> 営業時間・定休日・提供メニューは季節や仕入れにより変わることがあります。特に冬季営業や不定休の店は、訪問前に最新情報をご確認ください。</div>
  </section>
  <section class="border-y border-[var(--line)] bg-white/30">
    <div class="container-shell section-space grid items-center gap-10 lg:grid-cols-2">
      <div class="photo-frame aspect-[4/3]"><img src="/images/shinotsu-flowers.webp" alt="新篠津村の公園風景" loading="lazy" width="1600" height="1067" /></div>
      <div><span class="eyebrow">A SIMPLE PLAN</span><h2 class="display-title mt-5 text-4xl">湖畔ランチから、温泉へ。</h2><ol class="mt-7 space-y-5 text-sm leading-7 text-[var(--ink-soft)]"><li><strong class="text-[var(--ink)]">11:00</strong>　公園を散歩し、湖面と大きな空を眺める</li><li><strong class="text-[var(--ink)]">12:00</strong>　道の駅周辺で地元食材のランチ</li><li><strong class="text-[var(--ink)]">13:30</strong>　産直市場や売店でお土産を探す</li><li><strong class="text-[var(--ink)]">14:30</strong>　たっぷの湯でゆっくり温まる</li></ol></div>
    </div>
  </section>
</BaseLayout>

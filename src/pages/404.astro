---
import BaseLayout from '@/layouts/BaseLayout.astro';
export const prerender = true;
---
<BaseLayout title="ページが見つかりません" noindex={true}>
  <section class="container-shell grid min-h-[65vh] place-items-center py-20 text-center"><div><p class="font-serif text-8xl text-[var(--lake)]">404</p><h1 class="display-title mt-5 text-3xl">この道の先に、ページはありません。</h1><p class="mt-4 text-sm text-[var(--ink-soft)]">URLをご確認いただくか、トップページからお進みください。</p><a href="/" class="btn-primary mt-8">トップへ戻る</a></div></section>
</BaseLayout>

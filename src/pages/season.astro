---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PageHero from '@/components/PageHero.astro';
import Icon from '@/components/Icon.astro';
import { seasons } from '@/data/site';
const images = ['/images/shinotsu-flowers.webp','/images/shinotsu-overview.webp','/images/shinotsu-tower-rocks.webp','/images/shinotsu-bridge.webp'];
---
<BaseLayout title="四季の楽しみ" description="春夏秋冬、しのつ公園と新篠津村で楽しめる湖畔散歩、キャンプ、地元グルメ、ワカサギ釣りを紹介。" image="/images/shinotsu-flowers.webp">
  <PageHero eyebrow="SEASONS" title="同じ湖、四つの旅。" description="風、光、空の色。しのつ公園は季節ごとにまったく違う表情を見せます。訪れる時期に合わせて、服装と過ごし方を選びましょう。" image="/images/shinotsu-flowers.webp" imageAlt="しのつ公園の季節の花" />
  <section class="section-space container-shell">
    <div class="space-y-20">
      {seasons.map((item, i) => (
        <article class="grid items-center gap-8 lg:grid-cols-2">
          <div class:list={['photo-frame aspect-[4/3]', i % 2 === 1 && 'lg:order-2']}><img src={images[i]} alt={`${item.season}のしのつ公園を思わせる風景`} loading="lazy" width="1600" height="1067" /></div>
          <div class:list={['lg:px-10', i % 2 === 1 && 'lg:order-1']}>
            <div class="flex items-end gap-4"><span class="font-serif text-7xl text-[var(--lake-deep)]">{item.season}</span><span class="pb-2 text-xs font-bold tracking-[.2em] text-[var(--ink-soft)]">{item.kana.toUpperCase()}</span></div>
            <h2 class="display-title mt-6 text-3xl md:text-4xl">{item.title}</h2>
            <p class="lead-text mt-5">{item.description}</p>
            <div class="mt-6 flex flex-wrap gap-2">{item.points.map((p) => <span class="rounded-full border border-[var(--line)] bg-white/50 px-4 py-2 text-xs font-semibold">{p}</span>)}</div>
          </div>
        </article>
      ))}
    </div>
  </section>
  <section class="border-y border-[var(--line)] bg-white/30">
    <div class="container-shell section-space grid gap-10 lg:grid-cols-[.8fr_1.2fr]">
      <div><span class="eyebrow">PACKING NOTES</span><h2 class="display-title mt-5 text-4xl">持っていくと安心なもの</h2></div>
      <div class="grid gap-4 sm:grid-cols-2">
        {[
          ['春・秋','風を通しにくい上着、歩きやすい靴'],
          ['夏','帽子、飲み物、虫よけ、日差し対策'],
          ['冬','防寒着、防水靴、手袋、時間に余裕'],
          ['通年','モバイルバッテリー、タオル、温泉セット'],
        ].map(([t,d]) => <div class="rounded-2xl border border-[var(--line)] bg-white/60 p-6"><p class="font-serif text-xl">{t}</p><p class="mt-3 text-sm leading-7 text-[var(--ink-soft)]">{d}</p></div>)}
      </div>
    </div>
  </section>
  <section class="section-space container-shell text-center"><h2 class="display-title text-3xl md:text-4xl">旅の日付が決まったら、アクセスを確認。</h2><a href="/access/" class="btn-primary mt-7">詳しい交通案内 <Icon name="arrow" class="h-4 w-4" /></a></section>
</BaseLayout>
